# このファイルをコピーして .env を作成し、値を埋めてください。
# .env はコミットされません(.gitignore 参照)。

# --- Proxmox VE API ---------------------------------------------------
# 読取/書込/破壊 各操作の実行に使う専用APIトークン。
# PVE側で必要最小限の権限を持つロールを別途作成し、そのロールにひもづくトークンを使うこと。
# (risk tierによるアプリ側の制御は、PVE側ACLの代替ではなく多層防御として位置づける)
PVE_API_URL=https://pve.example.internal:8006/api2/json
PVE_API_TOKEN_ID=user@pam!pve-agent-console
PVE_API_TOKEN_SECRET=
# 自己署名証明書を使っている場合のみ true にする(本番運用では正しい証明書を推奨)
PVE_API_TLS_INSECURE=false

# --- App / DB -----------------------------------------------------------
# apps/web(Next.js)がリッスンするポート。next start/next devが直接参照する変数名
PORT=3000
# 共有SQLiteデータベースのパス。apps/web・apps/mcp-tasks・apps/mcp-proxmoxすべてが参照する
DATABASE_PATH=./data/pve-agent-console.db

# --- AI Provider adapters -----------------------------------------------
# 注意: 各AIプロバイダーのAPIキーはここには置かない。
# Claude Code / Gemini CLI / Codex CLI はホスト上でCLI自身にサブスクリプション
# ログイン(claude login 等)させて使う想定のため、認証情報は各CLIのローカル設定に委ねる。
DEFAULT_AI_PROVIDER=claude-code
# カンマ区切りで有効化するプロバイダーを指定(オプトイン)
ENABLED_AI_PROVIDERS=claude-code
