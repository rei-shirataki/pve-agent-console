# このファイルをコピーして .env を作成し、値を埋めてください。
# .env はコミットされません(.gitignore 参照)。

# --- Proxmox VE API ---------------------------------------------------
# 読取/書込/破壊 各操作の実行に使う専用APIトークン。
# PVE側で必要最小限の権限を持つロールを別途作成し、そのロールにひもづくトークンを使うこと。
# (risk tierによるアプリ側の制御は、PVE側ACLの代替ではなく多層防御として位置づける)
PVE_API_URL=https://pve.example.internal:8006/api2/json
PVE_API_TOKEN_ID=user@pam!pve-agent-console
PVE_API_TOKEN_SECRET=
# 自己署名証明書を使っている場合のみ true にする(本番運用では正しい証明書を推奨)
PVE_API_TLS_INSECURE=false

# --- App / DB -----------------------------------------------------------
# apps/web(Next.js)がリッスンするポート。next start/next devが直接参照する変数名
PORT=3000
# 共有SQLiteデータベースのパス。apps/web・apps/mcp-tasks・apps/mcp-proxmoxすべてが参照する
DATABASE_PATH=./data/pve-agent-console.db

# --- AI Provider (opencode) ----------------------------------------------
# AIバックエンドは opencode( https://github.com/anomalyco/opencode )経由。
# apps/web起動時に子プロセスとして`opencode serve`を自動起動する(docs/adr/0001-adopt-opencode.md参照)。
#
# 使用するプロバイダー/モデル。未設定時はAPIキー不要な無料モデル(opencode/big-pickle)にフォールバックする。
# 本番運用では実際に使いたいプロバイダーのAPIキーを設定し、下記を明示的に指定すること
# (例: ANTHROPIC_API_KEY を設定した上で OPENCODE_PROVIDER_ID=anthropic, OPENCODE_MODEL_ID=claude-... 等。
# 各プロバイダーのAPIキー環境変数名はopencodeの認証ドキュメント( https://opencode.ai/docs/providers/ )に従う)。
# Claude Pro/Maxサブスクリプションのopencode経由利用は非公式(Anthropic ToS上グレー)のため、
# デフォルトにはせずオプトイン機能としてのみ用意する。
OPENCODE_PROVIDER_ID=opencode
OPENCODE_MODEL_ID=big-pickle
# opencode serveがリッスンするポート(apps/webが子プロセスとして起動する内部用)
OPENCODE_PORT=4097
